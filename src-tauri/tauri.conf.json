{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "foccus",
  "version": "0.1.0",
  "identifier": "com.idityage.foccus",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "title": "Foccus",
        "width": 400,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "center": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "url": "splashscreen.html"
      },
      {
        "label": "main",
        "title": "Foccus",
        "width": 800,
        "height": 500,
        "minWidth": 400,
        "minHeight": 300,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["sounds/*", "splashscreen.html", "icons/*"]
  }
}
